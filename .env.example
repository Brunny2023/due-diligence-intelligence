# Optional live RAG configuration. Leave blank for the offline deterministic demo.
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_HOST=
PINECONE_NAMESPACE=demo

# Embedding provider configuration. The current implementation uses an OpenAI-compatible embeddings API.
LLM_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# LLM reasoning is separate from embeddings and uses OpenRouter's OpenAI-compatible API.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-opus-5

# OpenRouter embeddings use the same OpenAI-compatible transport but a separate model/dimension contract.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSION=1536
