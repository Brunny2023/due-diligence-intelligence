# Server-side live RAG configuration. Keep values out of Git and frontend code.
PINECONE_API_KEY=
PINECONE_INDEX=northstar-ddi
PINECONE_HOST=
PINECONE_NAMESPACE=northstar-validation

# Backward-compatible direct OpenAI-compatible embedding configuration.
# OpenRouter variables below take precedence when OPENROUTER_API_KEY is set.
LLM_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# OpenRouter reasoning and embedding configuration.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-opus-5
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSION=1536

# Offline behavior is selected automatically when live provider credentials are absent.
